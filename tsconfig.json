{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": "../../../sketchup_web/frontend",
    "paths": {
      "@/*": ["src/*"],
      "@resources/*": ["./resources/*"],
      "@sass/*": ["./public/sass/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "noImplicitReturns": true,
    "moduleResolution": "Node",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "jsx": "preserve"
  },
  "include": [
    "./components/**/*.ts",
    "./components/**/*.vue",
    "./stories/**/*.ts",
    "../../../sketchup_web/frontend/src/**/*.ts",
    "../../../sketchup_web/frontend/src/**/*.vue"
  ]
}
